# ===================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env in your production environment (or set in Render / Railway / Vercel dashboard)
# ===================================================================

PORT=5000
NODE_ENV=production

# -------------------------------------------------------------------
# 1. 100% FREE PRODUCTION POSTGRESQL DATABASE
# Recommended Free Provider: Neon (https://neon.tech)
# Neon provides a free, instant, serverless PostgreSQL database with SSL.
# Example: postgresql://neondb_owner:npg_xxxx@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Alternative Free Providers: Supabase (https://supabase.com), Render PostgreSQL (https://render.com)
# -------------------------------------------------------------------
DATABASE_URL=postgresql://your_prod_user:your_prod_password@your_neon_host.aws.neon.tech/your_db?sslmode=require

# -------------------------------------------------------------------
# 2. JWT SECURITY KEY
# Use a strong, random 64-character secret key for signing tokens
# -------------------------------------------------------------------
JWT_SECRET=supersecret_production_jwt_key_qa_workspace_2026

# -------------------------------------------------------------------
# 3. NODEMAILER EMAIL CREDENTIALS (for sending user login credentials)
# Gmail Option:
# Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords
# -------------------------------------------------------------------
EMAIL_USER=projectdemo691@gmail.com
EMAIL_APP_PASSWORD=ppdyarcahnvawcdt

# -------------------------------------------------------------------
# 4. FRONTEND LIVE APPLICATION URL
# Set this to your live production frontend website URL (used in email "Sign In" buttons)
# -------------------------------------------------------------------
FRONTEND_URL=https://your-live-frontend-domain.com

